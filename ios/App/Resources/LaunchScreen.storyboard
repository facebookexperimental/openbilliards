<!--
  LaunchScreen — feature 016 T019 (the distribution contract 4, FR-010).
  Solid Slate Void #0b100c (design register), NO localizable text:
  visually continuous with the game's boot background so cold launch shows
  no white flash (verified by the L4 cold-launch flow, test-pyramid contract 4).
  sRGB 0x0b/0x10/0x0c = 0.04313725490196078 / 0.06274509803921569 /
  0.047058823529411764.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="OB-launch-vc">
    <device id="retina6_1" orientation="landscape" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="OB-launch-scene">
            <objects>
                <viewController id="OB-launch-vc" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="OB-launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="896" height="414"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" red="0.04313725490196078" green="0.06274509803921569" blue="0.047058823529411764" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <viewLayoutGuide key="safeArea" id="OB-launch-safearea"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="OB-launch-fr" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
</document>
