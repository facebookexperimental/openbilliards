{
  "name": "pool-sdk-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript SDK over the canonical openbilliards pool-core wasm kernel (issue #12). Node >= 20 and browser; plain ESM, no bundler.",
  "license": "MIT",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/sync-web.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  }
}
